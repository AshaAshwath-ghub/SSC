# IMPORTANT: This is a TEMPLATE file
# Copy this file to 02-secrets.yaml and fill in your actual values
# DO NOT commit 02-secrets.yaml to Git!
#
# To use:
# 1. Copy: cp 02-secrets.yaml.template 02-secrets.yaml
# 2. Fill in your actual secret values
# 3. Never commit 02-secrets.yaml to Git (it's in .gitignore)

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: ssc-app
type: Opaque
stringData:
  # Database Credentials
  DB_USER: "postgres"
  DB_PASSWORD: "CHANGE_ME_STRONG_PASSWORD"

  # Security Keys - GENERATE STRONG RANDOM VALUES!
  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
  SECRET_KEY: "CHANGE_ME_GENERATE_32_CHAR_RANDOM_STRING"
  JWT_SECRET_KEY: "CHANGE_ME_GENERATE_32_CHAR_RANDOM_STRING"
  JWT_ALGORITHM: "HS256"

  # OAuth Credentials - Google
  # Get from: https://console.cloud.google.com/
  GOOGLE_CLIENT_ID: "YOUR_GOOGLE_CLIENT_ID"
  GOOGLE_CLIENT_SECRET: "YOUR_GOOGLE_CLIENT_SECRET"
  GOOGLE_REDIRECT_URI: "https://yourdomain.com/api/v1/oauth/google/callback"

  # OAuth Credentials - Microsoft
  # Get from: https://portal.azure.com/
  MICROSOFT_CLIENT_ID: "YOUR_MICROSOFT_CLIENT_ID"
  MICROSOFT_CLIENT_SECRET: "YOUR_MICROSOFT_CLIENT_SECRET"
  MICROSOFT_REDIRECT_URI: "https://yourdomain.com/api/v1/oauth/microsoft/callback"
  MICROSOFT_TENANT: "YOUR_MICROSOFT_TENANT_ID"

  # OAuth Credentials - Apple
  # Get from: https://developer.apple.com/
  APPLE_CLIENT_ID: "YOUR_APPLE_SERVICE_ID"
  APPLE_TEAM_ID: "YOUR_APPLE_TEAM_ID"
  APPLE_KEY_ID: "YOUR_APPLE_KEY_ID"
  APPLE_PRIVATE_KEY: "YOUR_APPLE_PRIVATE_KEY_CONTENT"
  APPLE_REDIRECT_URI: "https://yourdomain.com/api/v1/oauth/apple/callback"

  # Duo Security
  # Get from: https://admin.duosecurity.com/
  DUO_AUTH_IKEY: "YOUR_DUO_AUTH_IKEY"
  DUO_AUTH_SKEY: "YOUR_DUO_AUTH_SKEY"
  DUO_AUTH_HOST: "YOUR_DUO_AUTH_HOST"
  DUO_ADMIN_IKEY: "YOUR_DUO_ADMIN_IKEY"
  DUO_ADMIN_SKEY: "YOUR_DUO_ADMIN_SKEY"
  DUO_ADMIN_HOST: "YOUR_DUO_ADMIN_HOST"
  DUO_REQUIRED: "false"

  # SendGrid (Email OTP)
  # Get from: https://app.sendgrid.com/settings/api_keys
  SENDGRID_API_KEY: "YOUR_SENDGRID_API_KEY"
  SENDGRID_FROM_EMAIL: "your-email@yourdomain.com"
  SENDGRID_FROM_NAME: "SSC Application OTP"

  # Twilio (SMS OTP)
  # Get from: https://console.twilio.com/
  TWILIO_ACCOUNT_SID: "YOUR_TWILIO_ACCOUNT_SID"
  TWILIO_AUTH_TOKEN: "YOUR_TWILIO_AUTH_TOKEN"
  TWILIO_PHONE_NUMBER: "+1234567890"

  # SMTP Configuration (Optional)
  SMTP_HOST: "smtp.gmail.com"
  SMTP_PORT: "587"
  SMTP_USER: "your-email@gmail.com"
  SMTP_PASSWORD: "YOUR_SMTP_PASSWORD"
  SMTP_FROM_EMAIL: "noreply@yourdomain.com"
  SMTP_USE_TLS: "true"

---
# PRODUCTION DEPLOYMENT OPTION:
# For better security, create secrets from command line instead:
#
# kubectl create secret generic app-secrets \
#   --from-literal=DB_PASSWORD='your-password' \
#   --from-literal=SECRET_KEY='your-secret-key' \
#   --from-literal=JWT_SECRET_KEY='your-jwt-secret' \
#   --from-literal=GOOGLE_CLIENT_ID='your-id' \
#   --from-literal=GOOGLE_CLIENT_SECRET='your-secret' \
#   --namespace=ssc-app
#
# OR use Azure Key Vault with CSI driver (RECOMMENDED for production)
